NODE_ENV=development
PORT=4000
APP_NAME=MAX Auth
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://maxauth:maxauth@localhost:5432/maxauth?schema=public
JWT_ACCESS_SECRET=replace_with_64_byte_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_64_byte_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=max-auth
JWT_AUDIENCE=max-ecosystem
GOOGLE_CLIENT_ID=replace_with_google_web_client_id
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
REFRESH_COOKIE_NAME=max_refresh_token
CSRF_SECRET=replace_with_32_byte_random_secret
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
MAIL_FROM=MAX Auth <no-reply@max-ai.name.ng>
MAIL_PROVIDER=console
RESEND_API_KEY=
OAUTH_AUTH_CODE_TTL_MINUTES=10
OAUTH_ACCESS_TOKEN_TTL_MINUTES=60
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
OIDC_ISSUER=http://localhost:4000
OIDC_KEY_ID=max-auth-1
OIDC_PRIVATE_KEY=replace_with_rsa_private_key_with_escaped_newlines
OIDC_PUBLIC_KEY=replace_with_rsa_public_key_with_escaped_newlines
OIDC_ID_TOKEN_TTL_SECONDS=600
LOG_LEVEL=info
LOG_DIR=logs

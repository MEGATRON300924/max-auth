// =========================================================
// MAX Auth - Prisma Schema
// Identity platform for the entire MAX ecosystem
// =========================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PLUS
  PRO
  BUSINESS
  ENTERPRISE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
  DEACTIVATED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_DELETION
}

enum AuditAction {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESH
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_SENT
  ACCOUNT_DELETED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  DEVICE_TRUSTED
  DEVICE_REVOKED
  SESSION_REVOKED
  TWO_FA_ENABLED
  TWO_FA_DISABLED
  RECOVERY_CODES_GENERATED
  CONNECTED_ACCOUNT_LINKED
  CONNECTED_ACCOUNT_UNLINKED
  OAUTH_CLIENT_CREATED
  OAUTH_CLIENT_SECRET_ROTATED
  OAUTH_CONSENT_GRANTED
  OAUTH_CONSENT_REVOKED
  PROFILE_UPDATED
  ADMIN_ACTION
}

enum ConnectedProvider {
  GOOGLE
  X
  INSTAGRAM
  SPOTIFY
  DISCORD
  GITHUB
  MICROSOFT
  TIKTOK
}

enum OAuthGrantType {
  AUTHORIZATION_CODE
  REFRESH_TOKEN
  CLIENT_CREDENTIALS
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum BusinessVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessMemberRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  MEMBER
  VIEWER
  DEVELOPER
}

enum BusinessMemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum BusinessInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum BusinessAppConnectionStatus {
  ACTIVE
  REVOKED
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  username           String             @unique @db.VarChar(32)
  fullName           String?            @db.VarChar(128)
  displayName        String?            @db.VarChar(64)
  email              String             @unique @db.VarChar(255)
  passwordHash       String
  avatarUrl          String?
  country            String?            @db.VarChar(2)
  language           String?            @db.VarChar(10)
  timezone           String?            @db.VarChar(64)
  subscriptionTier   SubscriptionTier   @default(FREE)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  status             AccountStatus      @default(ACTIVE)
  isAdmin            Boolean            @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  sessions            Session[]
  devices             Device[]
  loginHistory        LoginHistory[]
  auditLogs           AuditLog[]
  usageEvents         UsageEvent[]
  passwordHistory     PasswordHistory[]
  verificationTokens  VerificationToken[]
  twoFactor           TwoFactorAuth?
  recoveryCodes       RecoveryCode[]
  passkeys            Passkey[]
  connectedAccounts   ConnectedAccount[]
  oauthIntegrationStates OAuthIntegrationState[]
  aiProfile           AIProfile?
  aiConversations     AIConversation[]
  oauthAuthCodes      OAuthAuthorizationCode[]
  oauthAccessTokens   OAuthAccessToken[]
  oauthRefreshTokens  OAuthRefreshToken[]
  oauthConsents       OAuthConsent[]
  ownedOAuthClients   OAuthClient[]
  ownedBusinesses     Business[] @relation("BusinessOwner")
  businessMemberships BusinessMembership[]
  businessInvitationsSent BusinessInvitation[] @relation("BusinessInvitationInviter")
  businessAppConnections BusinessAppConnection[] @relation("BusinessAppConnectionAuthorizer")
  @@index([email])
  @@index([username])
  @@index([status])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String?   @db.Uuid
  device           Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean   @default(false)
  revokedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@map("sessions")
}

model Device {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String?
  deviceType   String?
  os           String?
  browser      String?
  fingerprint  String?   @unique
  isTrusted    Boolean   @default(false)
  trustedAt    DateTime?
  lastIp       String?
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  sessions     Session[]
  @@index([userId])
  @@map("devices")
}

model LoginHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success     Boolean
  ipAddress   String?
  userAgent   String?
  location    String?
  reason      String?
  createdAt   DateTime @default(now())
  @@index([userId])
  @@index([createdAt])
  @@map("login_history")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @db.Uuid
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model UsageEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(255)
  statusCode Int
  durationMs Int
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([statusCode, createdAt])
  @@index([createdAt])
  @@map("usage_events")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())
  @@index([userId])
  @@map("password_history")
}

model VerificationToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String       @unique
  purpose    TokenPurpose
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime     @default(now())
  @@index([userId, purpose])
  @@map("verification_tokens")
}

model TwoFactorAuth {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isEnabled    Boolean   @default(false)
  method       String?
  secretEncrypted String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@map("two_factor_auth")
}

model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("recovery_codes")
}

model Passkey {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId    String   @unique
  publicKey       String
  counter         BigInt   @default(0)
  deviceLabel     String?
  transports      String?
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?
  @@index([userId])
  @@map("passkeys")
}

model ConnectedAccount {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          ConnectedProvider
  providerAccountId String
  accessTokenEnc    String?
  refreshTokenEnc   String?
  scope             String?
  tokenExpiresAt    DateTime?
  linkedAt          DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("connected_accounts")
}

model OAuthIntegrationState {
  id          String   @id @default(uuid()) @db.Uuid
  provider    ConnectedProvider
  stateHash   String   @unique @map("state_hash")
  userId      String   @db.Uuid @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifierEnc String   @map("verifier_enc")
  expiresAt   DateTime @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([userId, provider])
  @@index([expiresAt])
  @@map("oauth_integration_states")
}

model AIProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests          Json?
  preferences        Json?
  languages          Json?
  connectedServices  Json?
  memoryMetadata     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@map("ai_profiles")
}

model OAuthClient {
  id              String   @id @default(uuid()) @db.Uuid
  clientId        String   @unique
  clientSecretHash String
  name            String
  ownerId         String?  @db.Uuid
  owner           User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  redirectUris    String[]
  scopes          String[]
  isConfidential  Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  authCodes       OAuthAuthorizationCode[]
  accessTokens    OAuthAccessToken[]
  refreshTokens   OAuthRefreshToken[]
  consents        OAuthConsent[]
  businessConnections BusinessAppConnection[]
  @@map("oauth_clients")
}

model OAuthAuthorizationCode {
  id           String   @id @default(uuid()) @db.Uuid
  codeHash     String   @unique
  clientId     String   @db.Uuid
  client       OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri  String
  businessId   String?  @db.Uuid @map("business_id")
  businessContext Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  scopes       String[]
  codeChallenge String?
  codeChallengeMethod String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime @default(now())
  @@index([clientId])
  @@index([userId])
  @@index([businessId])
  @@map("oauth_authorization_codes")
}

model OAuthAccessToken {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  clientId   String   @db.Uuid
  client     OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?  @db.Uuid @map("business_id")
  businessContext Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  scopes     String[]
  grantType  OAuthGrantType @default(AUTHORIZATION_CODE)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  @@index([clientId])
  @@index([userId])
  @@index([businessId])
  @@map("oauth_access_tokens")
}

model OAuthRefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  clientId   String   @db.Uuid
  client     OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?  @db.Uuid @map("business_id")
  businessContext Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  scopes     String[]
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  @@index([clientId])
  @@index([userId])
  @@index([businessId])
  @@map("oauth_refresh_tokens")
}

model OAuthConsent {
  id         String   @id @default(uuid()) @db.Uuid
  clientId   String   @db.Uuid
  client     OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes     String[]
  grantedAt  DateTime @default(now())
  revokedAt  DateTime?
  @@unique([clientId, userId])
  @@map("oauth_consents")
}


model Business {
  id                          String                     @id @default(uuid()) @db.Uuid
  businessId                  String                     @unique @map("business_id") @db.VarChar(48)
  handle                      String                     @unique @db.VarChar(64)
  legalName                   String                     @map("legal_name") @db.VarChar(180)
  displayName                 String                     @map("display_name") @db.VarChar(120)
  email                       String                     @db.VarChar(254)
  phone                       String                     @db.VarChar(40)
  country                     String                     @db.VarChar(2)
  address                     String?                    @db.VarChar(500)
  businessType                String                     @map("business_type") @db.VarChar(80)
  websiteUrl                  String?                    @map("website_url") @db.VarChar(2048)
  logoUrl                     String?                    @map("logo_url") @db.VarChar(2048)
  description                 String?                    @db.VarChar(2000)
  registrationNumber          String?                    @map("registration_number") @db.VarChar(120)
  ownerId                     String                     @map("owner_id") @db.Uuid
  owner                       User                       @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  status                      BusinessStatus              @default(ACTIVE)
  verificationStatus           BusinessVerificationStatus @default(UNVERIFIED) @map("verification_status")
  emailVerifiedAt             DateTime?                  @map("email_verified_at")
  emailVerificationTokenHash  String?                    @unique @map("email_verification_token_hash")
  emailVerificationExpiresAt  DateTime?                  @map("email_verification_expires_at")
  createdAt                   DateTime                   @default(now()) @map("created_at")
  updatedAt                   DateTime                   @updatedAt @map("updated_at")
  memberships                 BusinessMembership[]
  invitations                 BusinessInvitation[]
  auditLogs                   BusinessAuditLog[]
  appConnections              BusinessAppConnection[]
  oauthAuthorizationCodes     OAuthAuthorizationCode[]
  oauthAccessTokens           OAuthAccessToken[]
  oauthRefreshTokens          OAuthRefreshToken[]
  @@index([ownerId])
  @@index([status, verificationStatus])
  @@index([email])
  @@map("businesses")
}

model BusinessMembership {
  id         String              @id @default(uuid()) @db.Uuid
  businessId String              @map("business_id") @db.Uuid
  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String              @map("user_id") @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessMemberRole  @default(MEMBER)
  status     BusinessMemberStatus @default(ACTIVE)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  @@unique([businessId, userId])
  @@index([userId, status])
  @@index([businessId, role, status])
  @@map("business_memberships")
}

model BusinessInvitation {
  id          String                  @id @default(uuid()) @db.Uuid
  businessId  String                  @map("business_id") @db.Uuid
  business    Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email       String                  @db.VarChar(254)
  role        BusinessMemberRole
  tokenHash   String                  @unique @map("token_hash")
  invitedById String                  @map("invited_by_id") @db.Uuid
  invitedBy   User                    @relation("BusinessInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  status      BusinessInvitationStatus @default(PENDING)
  expiresAt   DateTime                @map("expires_at")
  acceptedAt  DateTime?               @map("accepted_at")
  revokedAt   DateTime?               @map("revoked_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  @@index([businessId, status, expiresAt])
  @@index([email, status])
  @@map("business_invitations")
}

model BusinessAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  @@index([businessId, createdAt])
  @@index([actorId, createdAt])
  @@map("business_audit_logs")
}


model BusinessAppConnection {
  id             String                    @id @default(uuid()) @db.Uuid
  businessId     String                    @map("business_id") @db.Uuid
  business       Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId       String                    @map("client_id") @db.Uuid
  client         OAuthClient               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorizedById String                    @map("authorized_by_id") @db.Uuid
  authorizedBy   User                      @relation("BusinessAppConnectionAuthorizer", fields: [authorizedById], references: [id], onDelete: Restrict)
  scopes         String[]
  status         BusinessAppConnectionStatus @default(ACTIVE)
  connectedAt    DateTime                  @default(now()) @map("connected_at")
  revokedAt      DateTime?                 @map("revoked_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  @@unique([businessId, clientId])
  @@index([businessId, status])
  @@index([authorizedById])
  @@map("business_app_connections")
}

model AIConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(160)
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, updatedAt])
  @@map("ai_conversations")
}
